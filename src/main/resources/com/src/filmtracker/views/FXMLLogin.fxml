<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.src.filmtracker.controllers.auth.LoginController">
   <top>
      <HBox alignment="CENTER_RIGHT" prefHeight="50.0" spacing="10.0" style="-fx-background-color: #000000;" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#handleMinimize" style="-fx-background-color: transparent; -fx-cursor: hand;" text="—" textFill="WHITE">
               <font><Font name="System Bold" size="16.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#handleClose" style="-fx-background-color: transparent; -fx-cursor: hand;" text="X" textFill="WHITE">
               <font><Font name="System Bold" size="16.0" /></font>
               <HBox.margin><Insets right="15.0" /></HBox.margin>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" maxWidth="400.0" spacing="25.0" style="-fx-background-color: #1e1e1e; -fx-background-radius: 15;" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" spacing="15" >
                 <ImageView fitHeight="60.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                       <Image url="@../images/isotipo.png" />
                    </image>
                 </ImageView> 
                 <ImageView fitWidth="250.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                       <Image url="@../images/logotipo.png" />
                    </image>
                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                    <HBox.margin><Insets left="5.0" top="20.0" bottom="10.0" /></HBox.margin>
                 </ImageView>
             </HBox>
            
            <Label text="Iniciar Sesión" textFill="WHITE">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            
            <Label fx:id="errorLabel" managed="false" textAlignment="CENTER" textFill="#e50914" visible="false" wrapText="true" />
            
            <VBox spacing="5.0">
               <Label text="Correo Electrónico" textFill="#888888" >
                   <font><Font name="System Bold" /></font>
               </Label>
               <TextField fx:id="emailField" promptText="ejemplo@correo.com" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-padding: 10;" />
            </VBox>
            
            <VBox spacing="5.0">
               <Label text="Contraseña" textFill="#888888" >
                   <font><Font name="System Bold" /></font>
               </Label>
               <PasswordField fx:id="passwordField" promptText="••••••••" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-padding: 10;" />
            </VBox>
            
            <Button onAction="#handleForgotPassword" style="-fx-background-color: transparent; -fx-text-fill: #888888; -fx-cursor: hand;" text="¿Olvidaste tu contraseña?" underline="true" />
            
            <Button mnemonicParsing="false" onAction="#handleLogin" prefWidth="400.0" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-cursor: hand; -fx-background-radius: 5;" text="ENTRAR" />
            
            <HBox alignment="CENTER" spacing="5.0">
               <Label text="¿Nuevo por aquí?" textFill="#bbbbbb" />
               <Button mnemonicParsing="false" onAction="#goToRegister" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 0;" text="Regístrate ahora" underline="true">
                  <font><Font name="System Bold" size="12.0" /></font>
               </Button>
            </HBox>
         </children>
         <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
         <BorderPane.margin><Insets bottom="100.0" top="50.0" /></BorderPane.margin>
      </VBox>
   </center>
</BorderPane>