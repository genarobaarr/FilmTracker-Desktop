<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #121212; -fx-border-color: #333333; -fx-border-width: 2;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.src.filmtracker.controllers.moderation.ReportController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 15; -fx-background-color: #1e1e1e; -fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
            <children>
                <Label text="Emitir Reporte" textFill="WHITE">
                    <font><Font name="System Bold" size="18.0" /></font>
                </Label>
                <HBox HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleClose" style="-fx-background-color: transparent; -fx-cursor: hand;" text="X" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Button>
            </children>
        </HBox>
    </top>
    <center>
        <VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: #121212;">
            <children>
                <HBox alignment="TOP_LEFT" spacing="15" >
                    <children>
                        <ImageView fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/lotso.png" />
                           </image>
                           <HBox.margin><Insets left="10.0" /></HBox.margin>
                           <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                        </ImageView>
                    </children>
                </HBox>
                <Label fx:id="errorLabel" managed="false" textFill="#e50914" visible="false" wrapText="true" />
                
                <Label text="Motivo del reporte:" textFill="#888888">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                
                <ComboBox fx:id="reasonComboBox" prefWidth="400.0" promptText="Selecciona un motivo" style="-fx-background-color: #2a2a2a; -fx-control-inner-background: #2a2a2a;" />
                
                <Label text="Descripción (Opcional):" textFill="#888888">
                    <font><Font name="System Bold" size="12.0" /></font>
                </Label>
                
                <TextArea fx:id="descriptionArea" prefRowCount="4" promptText="Proporciona detalles adicionales..." style="-fx-control-inner-background: #2a2a2a; -fx-text-inner-color: white;" />
                
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleClose" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-cursor: hand;" text="Cancelar" />
                        <Button mnemonicParsing="false" onAction="#handleSubmit" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Enviar Reporte" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
