<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.src.filmtracker.controllers.admin.AdminPanelController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15; -fx-background-color: #1e1e1e; -fx-border-color: #333333; -fx-border-width: 0 0 1 0;">
            <children>
                <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="← VOLVER" />
                <Label text="Panel de Administración" textFill="WHITE">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>
                <HBox HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleMinimize" style="-fx-background-color: transparent; -fx-cursor: hand;" text="—" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleClose" style="-fx-background-color: transparent; -fx-cursor: hand;" text="X" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Button>
            </children>
        </HBox>
    </top>
    <center>
        <TabPane side="TOP" styleClass="floating" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <Tab text="Gestión de Usuarios">
                    <content>
                        <SplitPane dividerPositions="0.4" style="-fx-background-color: #121212; -fx-padding: 10;">
                            <items>
                                <VBox spacing="10.0" style="-fx-background-color: #1a1a1a; -fx-padding: 15; -fx-background-radius: 8;">
                                    <HBox spacing="10.0">
                                        <TextField fx:id="searchUserField" prefWidth="250.0" promptText="Buscar por nombre o username..." style="-fx-control-inner-background: #2a2a2a; -fx-text-inner-color: white;" HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#handleSearchUsers" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-cursor: hand;" text="Buscar" />
                                    </HBox>
                                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                        <content>
                                            <VBox fx:id="usersListContainer" spacing="10.0" />
                                        </content>
                                    </ScrollPane>
                                </VBox>
                                <VBox fx:id="userDetailPane" spacing="15.0" style="-fx-background-color: #1a1a1a; -fx-padding: 20; -fx-background-radius: 8;" />
                            </items>
                        </SplitPane>
                    </content>
                </Tab>
                <Tab onSelectionChanged="#loadReports" text="Revisión de Reportes">
                    <content>
                        <SplitPane dividerPositions="0.4" style="-fx-background-color: #121212; -fx-padding: 10;">
                            <items>
                                <VBox spacing="10.0" style="-fx-background-color: #1a1a1a; -fx-padding: 15; -fx-background-radius: 8;">
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label text="Estado:" textFill="WHITE" />
                                        <ComboBox fx:id="reportStatusFilter" onAction="#loadReports" prefWidth="150.0" style="-fx-background-color: #2a2a2a;" />
                                    </HBox>
                                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                        <content>
                                            <VBox fx:id="reportsListContainer" spacing="10.0" />
                                        </content>
                                    </ScrollPane>
                                </VBox>
                                <VBox fx:id="reportDetailPane" spacing="15.0" style="-fx-background-color: #1a1a1a; -fx-padding: 20; -fx-background-radius: 8;" />
                            </items>
                        </SplitPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>