<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<BorderPane style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.src.filmtracker.controllers.users.ProfileController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0" style="-fx-background-color: #000000;" BorderPane.alignment="CENTER">
            <children>
                <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="← VOLVER" >
                    <HBox.margin>
                        <Insets left="15.0" />
                    </HBox.margin>
                </Button>
                <HBox HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleMinimize" style="-fx-background-color: transparent; -fx-cursor: hand;" text="—" textFill="WHITE">
              <font><Font name="System Bold" size="16.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleClose" style="-fx-background-color: transparent; -fx-cursor: hand;" text="X" textFill="WHITE">
                   <font><Font name="System Bold" size="16.0" /></font>
                   <HBox.margin><Insets right="15.0" /></HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #121212; -fx-background: #121212;">
            <content>
                <VBox alignment="CENTER" spacing="25.0" style="-fx-padding: 20; -fx-background-color: #121212;">
                    <children>
                        <ImageView fx:id="avatarView" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
                
                        <VBox alignment="CENTER" spacing="10.0">
                            <StackPane>
                                <HBox fx:id="nameDisplayBox" alignment="CENTER" spacing="10.0">
                                    <Label fx:id="nameLabel" textFill="WHITE">
                                        <font><Font name="System Bold" size="28.0" /></font>
                                    </Label>
                                    <Button fx:id="editNameBtn" onAction="#handleEditName" style="-fx-background-color: transparent; -fx-text-fill: #e50914; -fx-cursor: hand;" text="✎" />
                                </HBox>
                                <HBox fx:id="nameEditBox" alignment="CENTER" managed="false" spacing="10.0" visible="false">
                                    <TextField fx:id="nameField" promptText="Nuevo nombre" style="-fx-control-inner-background: #2a2a2a; -fx-text-fill: white;" />
                                    <Button onAction="#handleSaveName" style="-fx-background-color: #2a2a2a; -fx-text-fill: #4caf50; -fx-cursor: hand;" text="✓" />
                                    <Button onAction="#handleCancelName" style="-fx-background-color: #2a2a2a; -fx-text-fill: #e50914; -fx-cursor: hand;" text="✕" />
                                </HBox>
                            </StackPane>
                            <StackPane>
                                <HBox fx:id="usernameDisplayBox" alignment="CENTER" spacing="10.0">
                                    <Label fx:id="usernameLabel" textFill="#e50914">
                                        <font><Font size="16.0" /></font>
                                    </Label>
                                    <Button fx:id="editUsernameBtn" onAction="#handleEditUsername" style="-fx-background-color: transparent; -fx-text-fill: #e50914; -fx-cursor: hand;" text="✎" />
                                </HBox>
                                <HBox fx:id="usernameEditBox" alignment="CENTER" managed="false" spacing="10.0" visible="false">
                                    <TextField fx:id="usernameField" promptText="Nuevo usuario" style="-fx-control-inner-background: #2a2a2a; -fx-text-fill: white;" />
                                    <Button onAction="#handleSaveUsername" style="-fx-background-color: #2a2a2a; -fx-text-fill: #4caf50; -fx-cursor: hand;" text="✓" />
                                    <Button onAction="#handleCancelUsername" style="-fx-background-color: #2a2a2a; -fx-text-fill: #e50914; -fx-cursor: hand;" text="✕" />
                                </HBox>
                            </StackPane>

                            <HBox fx:id="friendActionsBox" alignment="CENTER" spacing="10.0" visible="false" managed="false">
                                <Button fx:id="addFriendBtn" onAction="#handleAddFriend" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Agregar amigo" />
                                <Button fx:id="removeFriendBtn" onAction="#handleRemoveFriend" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Eliminar amigo" />
                            </HBox>
                        </VBox>

                        <HBox alignment="CENTER" spacing="40.0" style="-fx-padding: 10 0 10 0;">
                            <children>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <Label fx:id="reviewsCountLabel" text="0" textFill="WHITE"><font><Font name="System Bold" size="20.0" /></font></Label>
                                    <Label text="Reseñas" textFill="#888888"><font><Font size="12.0" /></font></Label>
                                </VBox>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <Label fx:id="likesReceivedLabel" text="0" textFill="WHITE"><font><Font name="System Bold" size="20.0" /></font></Label>
                                    <Label text="Likes" textFill="#888888"><font><Font size="12.0" /></font></Label>
                                </VBox>
                                <VBox alignment="CENTER" spacing="5.0" onMouseClicked="#handleShowFriends" style="-fx-cursor: hand;">
                                    <Label fx:id="friendsCountLabel" text="0" textFill="WHITE"><font><Font name="System Bold" size="20.0" /></font></Label>
                                    <Label text="Amigos" textFill="#888888"><font><Font size="12.0" /></font></Label>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox fx:id="privateInfoContainer" alignment="CENTER" maxWidth="400.0" spacing="10.0" style="-fx-background-color: #1e1e1e; -fx-padding: 20; -fx-background-radius: 10;">
                            <children>
                                <Label text="EMAIL" textFill="#888888"><font><Font name="System Bold" size="10.0" /></font></Label>
                                <Label fx:id="emailLabel" textFill="WHITE"><font><Font size="16.0" /></font></Label>
                                <Label text="ROL" textFill="#888888"><font><Font name="System Bold" size="10.0" /></font></Label>
                                <Label fx:id="roleLabel" textFill="WHITE"><font><Font size="16.0" /></font></Label>
                                <Button mnemonicParsing="false" onAction="#handleChangePassword" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15;" text="CAMBIAR CONTRASEÑA">
                                    <VBox.margin>
                                        <Insets top="10.0" />
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>
                        
                        <Label fx:id="dateLabel" textFill="#555555"><font><Font size="12.0" /></font></Label>

                        <VBox fx:id="friendsListContainer" maxWidth="1000" spacing="10.0" visible="false" managed="false">
                            <children>
                                <Label text="Mis Amigos" textFill="WHITE">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <VBox fx:id="friendsListSection" spacing="15.0" />
                            </children>
                        </VBox>

                        <VBox fx:id="favoritesContainer" maxWidth="1000" spacing="10.0">
                            <children>
                                <Label fx:id="favoritesTitleLabel" text="Mis Series Favoritas" textFill="WHITE">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <VBox fx:id="favoritesSection" spacing="15.0" />
                            </children>
                        </VBox>
                        
                        <VBox fx:id="watchlistContainer" maxWidth="1000" spacing="10.0">
                            <children>
                                <Label text="Mi Watchlist" textFill="WHITE">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <VBox fx:id="watchlistSection" spacing="15.0" />
                            </children>
                        </VBox>

                        <VBox maxWidth="1000" spacing="10.0">
                            <children>
                                <Label fx:id="reviewsTitleLabel" text="Mis Reseñas Publicadas" textFill="WHITE">
                                    <font><Font name="System Bold" size="22.0" /></font>
                                </Label>
                                <VBox fx:id="reviewsSection" spacing="15.0" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>