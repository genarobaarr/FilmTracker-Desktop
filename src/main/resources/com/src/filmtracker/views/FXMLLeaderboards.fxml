<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.src.filmtracker.controllers.leaderboards.LeaderboardsController">
    <top>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="15.0" style="-fx-background-color: #000000;" BorderPane.alignment="CENTER">
            <children>
                <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="← VOLVER" >
                    <HBox.margin><Insets left="20.0" /></HBox.margin>
                </Button>
                <Label text="Marcadores de la Comunidad" textFill="WHITE">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>
                <HBox HBox.hgrow="ALWAYS" />
                <Label text="Periodo:" textFill="GRAY" />
                <ComboBox fx:id="periodComboBox" onAction="#handleFilterChange" prefWidth="150.0" style="-fx-background-color: #2a2a2a; -fx-text-fill: white;" />
                <Button mnemonicParsing="false" onAction="#handleMinimize" style="-fx-background-color: transparent; -fx-cursor: hand;" text="—" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Button>
                <Button mnemonicParsing="false" onAction="#handleClose" style="-fx-background-color: transparent; -fx-cursor: hand;" text="X" textFill="WHITE">
                    <font><Font name="System Bold" size="16.0" /></font>
                        <HBox.margin><Insets right="20.0" /></HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>
    <center>
        <TabPane side="TOP" styleClass="floating" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <Tab fx:id="tabUsers" text="Top Usuarios">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: #121212; -fx-background: #121212;">
                            <content>
                                <VBox fx:id="usersContainer" spacing="10.0" style="-fx-padding: 20;" />
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
                <Tab fx:id="tabReviews" text="Reseñas Populares">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: #121212; -fx-background: #121212;">
                            <content>
                                <VBox fx:id="reviewsContainer" spacing="15.0" style="-fx-padding: 20;" />
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
                <Tab fx:id="tabComments" text="Comentarios Destacados">
                    <content>
                        <ScrollPane fitToWidth="true" style="-fx-background-color: #121212; -fx-background: #121212;">
                            <content>
                                <VBox fx:id="commentsContainer" spacing="10.0" style="-fx-padding: 20;" />
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>