<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.src.filmtracker.controllers.auth.ResetPasswordController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0" style="-fx-background-color: #000000; -fx-padding: 0 15 0 15;">
         <children>
            <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="← VOLVER" />
            <HBox HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0" style="-fx-background-color: #1e1e1e; -fx-background-radius: 15;">
         <children>
             <HBox alignment="CENTER" spacing="15" >
                 <ImageView fitWidth="250.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                       <Image url="@../images/logotipo2.png" />
                    </image>
                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                 </ImageView>
             </HBox>
            <Label text="Nueva Contraseña" textFill="WHITE">
               <font><Font name="System Bold" size="24.0" /></font>
            </Label>
            <VBox spacing="5.0">
               <children>
                  <Label text="Código de Recuperación" textFill="#888888">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Label>
                  <TextField fx:id="tokenField" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-padding: 10;" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Nueva Contraseña" textFill="#888888">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Label>
                  <PasswordField fx:id="passwordField" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-padding: 10;" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Confirmar Contraseña" textFill="#888888">
                     <font><Font name="System Bold" size="12.0" /></font>
                  </Label>
                  <PasswordField fx:id="confirmField" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-padding: 10;" />
               </children>
            </VBox>
            <Label fx:id="errorLabel" managed="false" textFill="#e50914" visible="false" wrapText="true" />
            <Button onAction="#handleReset" prefWidth="400.0" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-cursor: hand;" text="RESTABLECER CONTRASEÑA" />
         </children>
         <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
         <BorderPane.margin><Insets bottom="100.0" top="50.0" /></BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
