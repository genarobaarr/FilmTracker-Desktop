<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.src.filmtracker.controllers.auth.VerifyEmailController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0" style="-fx-background-color: #000000; -fx-padding: 0 15 0 15;" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#handleBack" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="← VOLVER" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleMinimize" style="-fx-background-color: transparent; -fx-cursor: hand;" text="—" textFill="WHITE">
               <font><Font name="System Bold" size="16.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#handleClose" style="-fx-background-color: transparent; -fx-cursor: hand;" text="X" textFill="WHITE">
               <font><Font name="System Bold" size="16.0" /></font>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" maxWidth="450.0" spacing="20.0" style="-fx-background-color: #1e1e1e; -fx-background-radius: 15;" BorderPane.alignment="CENTER">
         <children>
            <Label text="FilmTracker" textFill="WHITE">
               <font><Font name="System Bold" size="36.0" /></font>
            </Label>
            <Label text="Verificación de Correo" textFill="WHITE">
               <font><Font size="20.0" /></font>
            </Label>
            
            <Label text="Hemos enviado un código de 6 dígitos a tu bandeja de entrada. Introdúcelo a continuación para verificar tu cuenta." textFill="#bbbbbb" wrapText="true" textAlignment="CENTER">
               <font><Font size="14.0" /></font>
               <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Label>

            <Label fx:id="errorLabel" textFill="#e50914" visible="false" managed="false" wrapText="true" textAlignment="CENTER" />
            <Label fx:id="successLabel" textFill="#4caf50" visible="false" managed="false" wrapText="true" textAlignment="CENTER" />
            
            <VBox spacing="5.0" alignment="CENTER">
               <TextField fx:id="codeField" promptText="000000" alignment="CENTER" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-padding: 15; -fx-font-size: 24; -fx-letter-spacing: 10px;" maxWidth="200.0" />
            </VBox>
            
            <Button mnemonicParsing="false" onAction="#handleVerify" prefWidth="400.0" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-cursor: hand; -fx-background-radius: 5;" text="VERIFICAR CUENTA" />
            
            <HBox alignment="CENTER" spacing="5.0">
               <Label text="¿No recibiste el código?" textFill="#bbbbbb" />
               <Button mnemonicParsing="false" onAction="#handleResend" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 0;" text="Reenviar código" underline="true">
                  <font><Font name="System Bold" size="12.0" /></font>
               </Button>
            </HBox>
         </children>
         <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
         <BorderPane.margin><Insets bottom="100.0" top="50.0" /></BorderPane.margin>
      </VBox>
   </center>
</BorderPane>